            </KeyedObject>
            <!-- Set square brandished triumphantly -->
            <KeyedObject objectId="0:120">
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0.4" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.8" frame="38" interpolationType="linear"/>
                    <KeyFrameDouble value="0.4" frame="90" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Sparkles burst in celebration -->
            <KeyedObject objectId="0:110">
