        </LinearAnimation>

        <!-- 4. Supernova: 360° spinning solar halo + high energy breathing (loop) -->
        <LinearAnimation loopValue="loop" fps="60" duration="180" name="supernova" id="0:33">
            <!-- Solar Halo continuous 360° rotation (2π rad = 6.2831855) -->
            <KeyedObject objectId="0:200">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0.95" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.95" frame="180" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
