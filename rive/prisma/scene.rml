        </LinearAnimation>

        <!-- 2. Thinking: Inquisitive head sway and eye calculation (loop) -->
        <LinearAnimation loopValue="loop" fps="60" duration="120" name="thinking" id="0:31">
            <!-- Head assembly tilts inquiringly -->
            <KeyedObject objectId="0:150">
