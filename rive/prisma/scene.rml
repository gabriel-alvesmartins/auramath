        <!-- Animations -->

        <!-- 1. Idle: Thorax breathing + tail wag (loop) -->
        <LinearAnimation loopValue="loop" fps="60" duration="120" name="idle" id="0:30">
            <!-- Torso breathing: scaleY and scaleX -->
            <KeyedObject objectId="0:170">
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.04" frame="60" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="120" interpolationType="linear"/>
