        <!-- State Machine & Controller -->
        <StateMachine name="PrismaController" id="0:10">
            <!-- Numerical State: 0=idle, 1=thinking, 2=eureka, 3=supernova, 4=hint -->
            <StateMachineNumber name="state" id="0:20"/>
            <!-- One-shot trigger for instant celebration -->
            <StateMachineTrigger name="triggerEureka" id="0:21"/>

            <StateMachineLayer name="BaseMotion" id="0:40">
                <EntryState x="-100" y="0">
                    <StateTransition stateToId="0:50"/>
                </EntryState>

                <!-- State 0: Idle -->
                <AnimationState x="100" y="0" animationId="0:30" id="0:50">
                    <StateTransition stateToId="0:51" duration="200">
