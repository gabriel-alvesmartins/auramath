                </KeyedProperty>
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.06" frame="90" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="180" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.06" frame="90" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="180" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- Quick energetic chest pulsation -->
            <KeyedObject objectId="0:170">
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1.05" frame="45" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="90" interpolationType="linear"/>
                    <KeyFrameDouble value="1.05" frame="135" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="180" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- 5. Hint: Set square pointing forward with pulse (loop) -->
        <LinearAnimation loopValue="loop" fps="60" duration="90" name="hint" id="0:34">
            <KeyedObject objectId="0:120">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="85" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="102" frame="45" interpolationType="linear"/>
                    <KeyFrameDouble value="85" frame="90" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0.4" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.6" frame="45" interpolationType="linear"/>
                    <KeyFrameDouble value="0.4" frame="90" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

    </Artboard>
</Rive>
