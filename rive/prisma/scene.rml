        <!-- 3. Eureka: Elastic jump, squash & stretch, starburst (oneShot) -->
        <LinearAnimation loopValue="oneShot" fps="60" duration="90" name="eureka" id="0:32">
            <!-- Whole mascot jumps in Y with squash & stretch -->
            <KeyedObject objectId="0:100">
                <!-- Y position -->
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="260" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="268" frame="12" interpolationType="linear"/>
                    <KeyFrameDouble value="200" frame="38" interpolationType="linear"/>
                    <KeyFrameDouble value="263" frame="58" interpolationType="linear"/>
                    <KeyFrameDouble value="257" frame="74" interpolationType="linear"/>
                    <KeyFrameDouble value="260" frame="90" interpolationType="linear"/>
