#!/bin/sh
# ==============================================================================
# AuraMath Spec-Anchored Pre-Commit Hook
# Impede commits com Specification Drift, erros de tipos TypeScript ou testes quebrados
# ==============================================================================

echo ""
echo "🛡️  ========================================================"
echo "    GUARDA PRÉ-COMMIT SPEC-ANCHORED · AURAMATH"
echo "========================================================"
echo ""

# 1. Auditoria Spec-Anchored (Garante zero drift entre specs e código)
echo "🔍 [1/3] Verificando conformidade com especificações ativas..."
node scripts/spec-compliance.mjs
SPEC_EXIT=$?

if [ $SPEC_EXIT -ne 0 ]; then
  echo ""
  echo "❌ [ERRO BLOQUEANTE]: Divergência detectada com as especificações (Drift)!"
  echo "👉 Ação requerida: Alinhe o código com as especificações ou atualize a spec correspondente em openspec/specs/."
  echo "   Execute 'npm run spec:check' para inspecionar os detalhes."
  echo ""
  exit 1
fi

# 2. Verificação de Tipos TypeScript (npx tsc --noEmit)
echo ""
echo "📐 [2/3] Verificando integridade de tipos TypeScript..."
npx tsc --noEmit
TSC_EXIT=$?

if [ $TSC_EXIT -ne 0 ]; then
  echo ""
  echo "❌ [ERRO BLOQUEANTE]: Erros de tipagem TypeScript detectados!"
  echo "👉 Corrija os erros do compilador antes de commitar."
  echo ""
  exit 1
fi

# 3. Testes E2E Críticos (203 testes em ~1 segundo)
echo ""
echo "🧪 [3/3] Executando suíte de testes de regressão E2E..."
node --experimental-strip-types --test test/e2e/*.test.mjs
TEST_EXIT=$?

if [ $TEST_EXIT -ne 0 ]; then
  echo ""
  echo "❌ [ERRO BLOQUEANTE]: Falha em testes automatizados!"
  echo "👉 Execute 'npm run test:e2e' para inspecionar os testes que falharam."
  echo ""
  exit 1
fi

echo ""
echo "✅ Todos os contratos Spec-Anchored validados com sucesso!"
echo "🚀 Commit aprovado para envio."
echo ""
exit 0
