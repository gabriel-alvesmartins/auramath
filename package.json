{
  "name": "auramath-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Auramath Monorepo - Cognitive mental math platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "test": "npm run test --workspaces --if-present && npm run test:e2e",
    "test:e2e": "node --experimental-strip-types --test test/e2e/*.test.mjs",
    "build": "npm run build --workspaces --if-present && vite build",
    "build:web": "vite build",
    "lint": "npm run lint --workspaces --if-present",
    "prepare": "git config core.hooksPath .githooks 2>nul || true",
    "mascot:vectorize": "python scripts/vectorize-mascot.py",
    "spec:check": "node scripts/spec-compliance.mjs",
    "spec:sync": "node scripts/sync-github-backlog.mjs"
  },
  "dependencies": {
    "@rive-app/react-canvas": "^4.36.0",
    "@supabase/supabase-js": "^2.117.3",
    "canvas-confetti": "^1.9.2",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.2.0"
  },
  "keywords": [
    "mental-math",
    "cognitive-scaffolding",
    "react-native",
    "expo",
    "gamification"
  ],
  "author": "Auramath Team",
  "license": "MIT"
}
